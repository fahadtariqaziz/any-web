# Copy this file to .env and fill in real values. Never commit .env.

# --- Model provider: anthropic (Claude API, default) | local (Ollama on this machine, free, ~5-10x slower) ---
LLM_PROVIDER=anthropic
# Local mode: the graph agents, the chat and the coding agent all use LOCAL_MODEL. One-time setup + check:
#   ollama pull qwen3.5:4b-q4_K_M && cd backend && uv run python scripts/verify_local.py
# LOCAL_BASE_URL=http://localhost:11434
# LOCAL_MODEL=qwen3.5-4b-q4-32k       # created by verify_local.py from LOCAL_BASE_MODEL with a 32K context
# LOCAL_BASE_MODEL=qwen3.5:4b-q4_K_M  # 8 GB: qwen3.5:4b-q4_K_M · 16 GB: qwen3.5:9b-q4_K_M · 32 GB+: qwen3-coder:30b
#                                     # use q4_K_M / q8_0 tags, NOT -mlx / nvfp4 (Ollama's MLX runner grows to ~12 GB)
# LOCAL_MAX_PARALLEL=1                # local calls at the same time (parallel graph steps take turns)
# LOCAL_CODER_MODEL=                  # empty = LOCAL_MODEL (one model in memory)
# LOCAL_THINK=false                   # true = better answers, several times slower
# LOCAL_TIME_MULTIPLIER=6             # timeouts and the session time budget are multiplied by this locally

# --- Claude (needed when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Tavily web research ---
TAVILY_API_KEY=

# --- LangSmith tracing (set LANGSMITH_TRACING=false to disable) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-decision-arena
# Only needed for an EU LangSmith account: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- PostgreSQL (used from Phase 7) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_decision_arena
# Completion saves session / evidence / report to the app tables (create them once: uv run alembic upgrade head)
PERSIST_RESULTS=true

# --- App URLs (used from Phase 8) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Optional overrides (defaults live in src/ai_decision_arena/config.py) ---
# Cost limits per project (whole project, every change included):
# IMPLEMENTATION_BUDGET_USD=15          # coding agent: then no new task attempt starts
# SESSION_LLM_BUDGET_USD=5              # builder AI: then no more automatic research / clarification loops
# LLM_MAX_TOKENS=4000
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=2
# MAX_CLARIFICATION_ROUNDS=3
# MAX_RESEARCH_RETRIES=2
# MAX_DEBATE_ROUNDS=2
# QUERIES_PER_DOMAIN=3                 # research runs 3 domains: apps / papers / tech
# MAX_RESULTS_PER_QUERY=5
# MAX_HITS_PER_DOMAIN=12
# MAX_EVIDENCE_PER_DOMAIN=10
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_APPS_SEARCH_DEPTH=advanced     # review / forum snippets are too short with "basic"
# Patient chat ("quick" sessions at /): model for its agents, model that chats, and whether the Critic +
# Evidence Checker also run (about +20 s on top of the ~30 s onboarding)
# QUICK_MODEL=claude-haiku-5-5
# Backup model when the main model fails (overloaded, timeout, invalid output). Empty = no fallback.
# FALLBACK_MODEL=claude-haiku-5-5
# QUICK_FALLBACK_MODEL=claude-sonnet-5-5
# CHAT_MODEL=claude-sonnet-5-5
# QUICK_DOUBLE_CHECK=false
# RUBRIC_WEIGHTS={"fit_to_user":0.30,"safety":0.25,"evidence_quality":0.20,"practicality":0.15,"completeness":0.10}
# Scheduled check-ins (triggers.py): one follow-up message in patient chats quiet for N hours
# CHECK_INS_ENABLED=true
# CHECK_IN_QUIET_HOURS=24
# CHECK_IN_INTERVAL_SECONDS=3600
# CHECK_IN_MAX_PER_RUN=5
# Docker only (docker-compose.yml): database URL as seen from inside the container
# DOCKER_DATABASE_URL=postgresql://postgres:password@host.docker.internal:5432/ai_decision_arena

# Approve the implementation plan automatically once the brief is approved (no plan review pause).
# false = the user reviews the plan before the build starts.
# AUTO_APPROVE_PLAN=true

# --- Quality steps after the build (restart the backend after changing; settings are read once per process) ---
# Compound Engineering (M13): code review after a passing build check (HIGH findings -> one fix task per change)
# + project learnings (.builder/learnings.md, read by every later coding task). false = no review, no learnings.
# COMPOUND_ENGINEERING=true
# REVIEW_MODEL=claude-sonnet-5-5
# REVIEW_EFFORT=medium
# MAX_REVIEW_FIX_ROUNDS=1
# MAX_LEARNINGS=20
# Playwright browser tests (M12): the coding agent writes e2e/*.e2e.mjs for the MVP flows, the builder runs them in
# the installed Chrome after every build / change; a failing test -> a fix task. false = no browser tests.
# E2E_CHECK=true
# MAX_E2E_FIX_ROUNDS=2
# E2E_PORT_RANGE=4200-4299
